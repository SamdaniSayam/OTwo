# Copy this file to `.env.local` for local development.
# `.env.local` is git-ignored; never commit real values.

# Both values are public. `EXPO_PUBLIC_*` variables are bundled into the app.
# Use the Supabase publishable key (`sb_publishable_...`) from
# Dashboard -> Settings -> API Keys. The legacy `anon` JWT also works while
# Supabase migrates to the new key system.
#
# NEVER put a secret/service_role key in this file or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
